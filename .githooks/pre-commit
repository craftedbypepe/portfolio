#!/bin/sh
# Blocks commits that contain secrets. Install once with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner || {
  echo "pre-commit: possible secret found. Remove it before committing." >&2
  exit 1
}
